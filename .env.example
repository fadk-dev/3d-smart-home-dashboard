# Salin ke .env untuk override lokal. Jangan commit kredensial nyata.
# URL broker MQTT over WebSocket (default: broker publik EMQX untuk pengujian).
VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt

# Kredensial broker opsional (kosong = tanpa autentikasi).
# Hanya dipakai bila broker memerlukannya; gunakan akun berhak minimum
# (subscribe-only — aplikasi ini tidak pernah publish).
# VITE_MQTT_USERNAME=
# VITE_MQTT_PASSWORD=
